{
    "name": "diegofxm/cofacture",
    "description": "A PHP toolkit for Colombian DIAN electronic invoicing: UBL 2.1 document generation, XAdES-EPES signing, CUFE/CUDE/CUDS/CUNE computation, and a SOAP client for DIAN's WcfDianCustomerServices.",
    "type": "library",
    "license": "AGPL-3.0",
    "homepage": "https://github.com/diegofxm/cofacture-php",
    "keywords": [
        "dian",
        "colombia",
        "facturacion-electronica",
        "electronic-invoicing",
        "ubl",
        "ubl2.1",
        "xades",
        "cufe",
        "nomina-electronica",
        "documento-soporte"
    ],
    "authors": [
        {
            "name": "Diego Montoya"
        }
    ],
    "support": {
        "issues": "https://github.com/diegofxm/cofacture-php/issues",
        "source": "https://github.com/diegofxm/cofacture-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-openssl": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Cofacture\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cofacture\\Tests\\": "tests/"
        }
    }
}
